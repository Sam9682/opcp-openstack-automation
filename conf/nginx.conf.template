events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    # Use Docker's embedded DNS server so the "app" service name is resolved
    # at request time rather than at startup. Combined with a variable in
    # proxy_pass below, this prevents nginx from failing with
    # "host not found in upstream" (and crash-looping) when the app
    # container is not yet ready.
    resolver 127.0.0.11 valid=10s ipv6=off;

    upstream app {
        server app:5000;
    }

    server {
        listen 443 ssl;
        server_name _;

        ssl_certificate /etc/nginx/ssl/fullchain.pem;
        ssl_certificate_key /etc/nginx/ssl/privkey.pem;
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_ciphers HIGH:!aNULL:!MD5;

        root /var/www/html;
        index index.html;

        # Proxy API and app routes to Flask
        location /api/ {
            set $app_upstream http://app:5000;
            proxy_pass $app_upstream;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location /health {
            set $app_upstream http://app:5000;
            proxy_pass $app_upstream;
            proxy_set_header Host $host;
        }

        location /admin {
            set $app_upstream http://app:5000;
            proxy_pass $app_upstream;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location /billing {
            set $app_upstream http://app:5000;
            proxy_pass $app_upstream;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # Serve static files directly
        location / {
            try_files $uri $uri/ $uri.html /404.html;
        }

        # Cache static assets
        location ~* \.(css|js|png|jpg|jpeg|gif|svg|ico|woff2?)$ {
            expires 1h;
            add_header Cache-Control "public, no-transform";
        }

        error_page 404 /404.html;
    }
}
